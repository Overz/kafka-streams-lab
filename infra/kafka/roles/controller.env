# Papel controller: so participa do quorum KRaft (metadados do cluster). Nao serve
# dado a producer/consumer nenhum. Separar do broker e o que permite matar o plano
# de controle sem tocar no plano de dados -- e vice-versa -- nos exercicios 3 e 4.
# Identico nos dois clusters; o que varia (CLUSTER_ID, quorum voters) esta em
# cluster-{a,b}/common.env.
KAFKA_PROCESS_ROLES=controller
KAFKA_LISTENERS=CONTROLLER://:9093
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT

# Controller guarda so o log de metadados -- nao precisa de heap grande.
KAFKA_HEAP_OPTS=-Xms256m -Xmx256m
