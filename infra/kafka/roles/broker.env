# Papel broker: serve dado, nao vota no quorum. Descobre os controllers via
# KAFKA_CONTROLLER_QUORUM_VOTERS (em cluster-{a,b}/common.env).
#
# Dois listeners por broker:
#   INTERNAL :9092  -> trafego entre brokers e a partir de containers (MM2, kafbat)
#   EXTERNAL :190xx -> apps rodando no host (./mvnw, go run), via localhost
# LISTENERS e ADVERTISED_LISTENERS ficam no compose porque a porta EXTERNAL muda
# por broker.
KAFKA_PROCESS_ROLES=broker
KAFKA_INTER_BROKER_LISTENER_NAME=INTERNAL
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=INTERNAL:PLAINTEXT,EXTERNAL:PLAINTEXT,CONTROLLER:PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER

KAFKA_HEAP_OPTS=-Xms512m -Xmx512m
