TZ=UTC

# Gerado com: kafka-storage.sh random-uuid
# Precisa ser DIFERENTE do cluster-b -- sao dois clusters independentes, e o
# CLUSTER_ID e o que os distingue.
CLUSTER_ID=jCRZjivpSlC9UCHGEccVuw

# Tem que apontar para dentro do volume montado. No compose de referencia isso
# estava desalinhado (LOG_DIRS=/var/lib/kafka/logs, volume em /data) e os dados
# viviam no layer efemero do container -- "down" apagava tudo.
KAFKA_LOG_DIRS=/var/lib/kafka/data
KAFKA_LOG_RETENTION_HOURS=168

# --- Alta disponibilidade -------------------------------------------------
# RF=3 sobre 3 brokers, e min.insync.replicas=2 com acks=all no producer:
# perder 1 broker nao interrompe a escrita, perder 2 interrompe. Interromper e o
# comportamento correto -- escrever com 1 replica e perder dado silenciosamente
# na proxima falha.
KAFKA_NUM_PARTITIONS=3
KAFKA_DEFAULT_REPLICATION_FACTOR=3
KAFKA_MIN_INSYNC_REPLICAS=2
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=3
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=3
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=2
KAFKA_SHARE_COORDINATOR_STATE_TOPIC_REPLICATION_FACTOR=3
KAFKA_SHARE_COORDINATOR_STATE_TOPIC_MIN_ISR=2

# Prefere ficar indisponivel a eleger uma replica atrasada como lider e descartar
# mensagens ja confirmadas ao producer.
KAFKA_UNCLEAN_LEADER_ELECTION_ENABLE=false

# Topico criado automaticamente nasce com o default do broker e ninguem percebe
# se o RF saiu errado. Criacao explicita fica em config-server/src/main/resources/kafka/.
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false

KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0

# --- Quorum KRaft ---------------------------------------------------------
# 3 votantes: maioria 2, tolera perder 1. Com 2 votantes a maioria tambem seria 2,
# entao perder qualquer um congelaria o plano de controle.
# Os nomes sao os service names do compose -- o Docker registra alias de DNS por
# service name na rede, o que "hostname:" sozinho nao faz.
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka-controller-a-1:9093,2@kafka-controller-a-2:9093,3@kafka-controller-a-3:9093

# --- Observabilidade ------------------------------------------------------
# O javaagent do Prometheus NAO entra aqui de proposito: environment do container
# e herdado por "docker exec", e toda ferramenta CLI morreria tentando bindar a
# 7071 ja ocupada pelo servidor. Ele e injetado por /opt/jmx/with-jmx.sh, que so
# o processo do servidor atravessa.
