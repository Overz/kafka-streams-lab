# Raiz da arvore de configuracao do Lombok: nada acima deste diretorio e consultado.
config.stopBubbling = true

# Marca todo membro gerado com @lombok.Generated. Ferramentas de cobertura e analise
# estatica passam a distinguir codigo escrito de codigo gerado.
lombok.addLombokGeneratedAnnotation = true

# Desde a 1.18.44 o @Jacksonized sabe gerar para Jackson 2 e para Jackson 3, e emite
# um warning em cada record ate que a versao seja declarada aqui. O lab usa a linha 2
# (com.fasterxml.jackson); a 3 tem outro groupId e nao esta no classpath.
lombok.jacksonized.jacksonVersion += 2

# val e @NonNull sao ruido num codigo que ja usa `final var` em todo lugar e records
# imutaveis: sinalizar o uso evita que voltem sem discussao.
lombok.val.flagUsage = WARNING

# Sem isto, @RequiredArgsConstructor gera o construtor e DEIXA o @Value no campo, onde o
# Spring nao o le em campo final -- a injecao some em silencio e o campo fica nulo.
# Copiada para o parametro do construtor gerado, a anotacao volta a funcionar, e um
# @Component com um valor de propriedade nao precisa mais de construtor escrito a mao.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
