<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Parent do Spring Boot, nao o agregador do lab. O agregador declara properties
       chamadas logback.version, jackson.version, junit.version, kafka.version e outras
       com exatamente os mesmos nomes que o spring-boot-dependencies usa internamente;
       herdadas aqui, elas reescrevem o BOM do Boot sem aviso. Foi assim que logback-classic
       1.6.3 acabou junto de logback-core 1.5.38 e o servidor morreu no primeiro log com
       AbstractMethodError. Este modulo continua no <modules> do agregador: participar do
       reactor nao exige heranca. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.8</version>
    <relativePath/>
  </parent>

  <groupId>com.github.overz</groupId>
  <artifactId>config-server</artifactId>
  <version>0.0.1</version>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Trilho do Spring Cloud pareado com o Boot 4.0.x. Trocar um exige trocar o outro. -->
    <spring-cloud.version>2025.1.3</spring-cloud.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Versao gerida pelo BOM do Boot. optional para nao vazar para quem dependa deste
         modulo; o spring-boot-maven-plugin ja o exclui do jar repackaged. Estar no
         classpath nao basta: ver annotationProcessorPaths mais abaixo. -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-config-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- AdminClient, para criar os topicos declarados em resources/kafka. Versao literal,
         pareada com a kafka.version do agregador: o BOM do Boot gere uma anterior, e um
         lab que fala com brokers 4.3.1 nao deve provisionar com um cliente de outra
         geracao. Literal e nao property: este modulo nao herda do agregador. -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <version>4.3.1</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Lombok tem de ser declarado como processador, e nao so estar no classpath: do
           JDK 23 em diante o javac roda com -proc:none por padrao e ignora processador
           descoberto pelo classpath. A versao vem do BOM do Boot, que e o parent deste
           modulo, e nao do agregador do lab. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
