<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuracao unica de log das aplicacoes Streams. Fica no shared, e nao duplicada em
  orders e antifraud, porque o formato do log e parte do contrato de observabilidade do
  lab: os dois dominios precisam sair iguais no OpenObserve para poderem ser comparados.

  Dois destinos:
    CONSOLE  o terminal de quem esta rodando a app no host
    OTEL     o collector, via OTLP; so passa a exportar depois de
             OpenTelemetryAppender.install(sdk), no OpenTelemetryBootstrap

  Nivel por variavel de ambiente, sem rebuild:

    LOG_LEVEL=info make orders          so o que a app diz
    LOG_LEVEL=trace make orders         tudo o que a app diz
    KAFKA_LOG_LEVEL=debug make orders   abre o cliente Kafka junto

  A mesma LOG_LEVEL, com o mesmo default, vale para a API em Go e para o config-server.
-->
<configuration>

  <!-- Logback resolve nesta ordem: system property, variavel de ambiente, e por fim o
       default depois de ":-". Um -DLOG_LEVEL=... na linha do java vence o ambiente. -->
  <property name="LOG_LEVEL" value="${LOG_LEVEL:-DEBUG}"/>

  <!-- Terceiros tem knob proprio de proposito. Com LOG_LEVEL=DEBUG por padrao, deixar o
       cliente Kafka seguir a raiz encheria o console de uma linha por registro processado
       e a app ficaria impossivel de acompanhar. Quem precisa depurar o Kafka liga so ele. -->
  <property name="KAFKA_LOG_LEVEL" value="${KAFKA_LOG_LEVEL:-WARN}"/>
  <property name="KAFKA_STREAMS_LOG_LEVEL" value="${KAFKA_STREAMS_LOG_LEVEL:-INFO}"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <!-- trace_id e span_id no console: e o que permite pegar um trace no OpenObserve
           a partir de uma linha vista no terminal. -->
      <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{28} [%X{trace_id:-}] - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Sem opcoes de captura aqui: o SDK as define por otel.instrumentation.logback-appender.*
       no OpenTelemetryBootstrap, e declarar nos dois lugares faz o appender avisar que a
       configuracao do arquivo foi ignorada. -->
  <appender name="OTEL" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender"/>

  <logger name="org.apache.kafka" level="${KAFKA_LOG_LEVEL}"/>
  <logger name="org.apache.kafka.streams" level="${KAFKA_STREAMS_LOG_LEVEL}"/>

  <!-- O codigo do lab acompanha a LOG_LEVEL, e e o ponto dela. -->
  <logger name="com.github.overz" level="${LOG_LEVEL}"/>

  <root level="${LOG_LEVEL}">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="OTEL"/>
  </root>
</configuration>
